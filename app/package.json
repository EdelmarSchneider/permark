{
  "name": "permark",
  "version": "0.6.1",
  "description": "A unified document workspace: read, write and organize Markdown and the files around it. Free and open source.",
  "license": "MIT OR Apache-2.0",
  "author": "Edelmar Schneider",
  "repository": {
    "type": "git",
    "url": "https://github.com/EdelmarSchneider/permark"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "tauri": "tauri",
    "fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all && prettier --write .",
    "fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && prettier --check .",
    "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --workspace && vitest run",
    "check": "npm run version:check && npm run fmt:check && npm run build && npm run lint && npm run test",
    "version:sync": "node scripts/version.mjs sync",
    "version:check": "node scripts/version.mjs check",
    "gen:languages": "node scripts/gen-code-languages.mjs && prettier --write src/plugins/highlight/languageData.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@lucide/svelte": "^1.59.0",
    "@milkdown/kit": "^7.22.3",
    "@plantuml/core": "^1.2026.9",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "mermaid": "^12.2.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
