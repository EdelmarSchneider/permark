{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PerMark",
  "version": "0.5.8",
  "identifier": "dev.permark.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PerMark",
        "visible": false,
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Read what your AI writes. Write what it reads. A free, open-source Markdown app.",
    "longDescription": "PerMark opens any Markdown file as a clean page you can edit, keeps notes that save themselves, and turns a project folder into a place to follow, review and steer what your AI agents write. A working environment for documents that works with any AI tool, or with none.",
    "copyright": "Copyright (c) 2026 Edelmar Schneider",
    "license": "MIT OR Apache-2.0",
    "licenseFile": "../../LICENSE-MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "PortugueseBR",
          "SpanishInternational",
          "German",
          "SimpChinese",
          "Italian"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1QjVEODA3MTNDNjE4ODUKUldTRkdNWVRCOWkxNVhhRkl4OFdxOXRyempvTU16R0xKL0Z5MzJIcU9wcmh3UWFZelFNR2JQQUkK",
      "endpoints": [
        "https://github.com/EdelmarSchneider/permark/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
