; Tauri's own installer strings (the pages and messages of its NSIS template) in Galician, which Tauri does not
; translate: `bundle.windows.nsis.customLanguageFiles` in tauri.conf.json points here. Same names as Tauri's English.nsh
; (Tauri CLI 2.12.3; 2.12.4 renamed choowHowToInstall to chooseHowToInstall: both are here, same words). Tauri copies the file as it is and adds the byte order mark itself, so the file has none; the
; product name is ${PRODUCTNAME}.
LangString addOrReinstall ${LANG_GALICIAN} "Engadir ou reinstalar compoñentes"
LangString alreadyInstalled ${LANG_GALICIAN} "Xa está instalado"
LangString alreadyInstalledLong ${LANG_GALICIAN} "${PRODUCTNAME} ${VERSION} xa está instalado. Seleccione a operación que quere realizar e prema Seguinte para continuar."
LangString appRunning ${LANG_GALICIAN} "${PRODUCTNAME} está en execución. Pécheo primeiro e ténteo de novo."
LangString appRunningOkKill ${LANG_GALICIAN} "${PRODUCTNAME} está en execución.$\nPrema Aceptar para pechalo."
LangString chooseMaintenanceOption ${LANG_GALICIAN} "Escolla a operación de mantemento que quere realizar."
LangString chooseHowToInstall ${LANG_GALICIAN} "Escolla como quere instalar ${PRODUCTNAME}."
LangString choowHowToInstall ${LANG_GALICIAN} "Escolla como quere instalar ${PRODUCTNAME}."
LangString createDesktop ${LANG_GALICIAN} "Crear un atallo no escritorio"
LangString dontUninstall ${LANG_GALICIAN} "Non desinstalar"
LangString dontUninstallDowngrade ${LANG_GALICIAN} "Non desinstalar (este instalador non permite instalar unha versión anterior sen desinstalar antes)"
LangString failedToKillApp ${LANG_GALICIAN} "Non foi posíbel pechar ${PRODUCTNAME}. Pécheo primeiro e ténteo de novo."
LangString installingWebview2 ${LANG_GALICIAN} "Instalando WebView2..."
LangString newerVersionInstalled ${LANG_GALICIAN} "Xa está instalada unha versión máis recente de ${PRODUCTNAME}. Non se recomenda instalar unha versión máis antiga. Se realmente quere instalar esta versión máis antiga, é mellor desinstalar primeiro a versión actual. Seleccione a operación que quere realizar e prema Seguinte para continuar."
LangString older ${LANG_GALICIAN} "máis antiga"
LangString olderOrUnknownVersionInstalled ${LANG_GALICIAN} "Hai unha versión $R4 de ${PRODUCTNAME} instalada no sistema. Recoméndase desinstalar a versión actual antes de instalar. Seleccione a operación que quere realizar e prema Seguinte para continuar."
LangString silentDowngrades ${LANG_GALICIAN} "Este instalador non permite instalar unha versión anterior, así que a instalación silenciosa non pode continuar. Use o instalador con interface gráfica.$\n"
LangString unableToUninstall ${LANG_GALICIAN} "Non foi posíbel desinstalar."
LangString uninstallApp ${LANG_GALICIAN} "Desinstalar ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_GALICIAN} "Desinstalar antes de instalar"
LangString unknown ${LANG_GALICIAN} "descoñecida"
LangString webview2AbortError ${LANG_GALICIAN} "Non foi posíbel instalar WebView2. A aplicación non pode funcionar sen el. Probe a reiniciar o instalador."
LangString webview2DownloadError ${LANG_GALICIAN} "Erro: non foi posíbel descargar WebView2 - $0"
LangString webview2DownloadSuccess ${LANG_GALICIAN} "O instalador de arranque de WebView2 descargouse correctamente"
LangString webview2Downloading ${LANG_GALICIAN} "Descargando o instalador de arranque de WebView2..."
LangString webview2InstallError ${LANG_GALICIAN} "Erro: a instalación de WebView2 fallou co código de saída $1"
LangString webview2InstallSuccess ${LANG_GALICIAN} "WebView2 instalouse correctamente"
LangString deleteAppData ${LANG_GALICIAN} "Eliminar os datos da aplicación"
