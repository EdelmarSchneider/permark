        {
          "html": "<h1 data-b=\"93113f53a7490843\" id=\"project-rules\">Project rules</h1>",
          "id": "93113f53a7490843",
          "kind": "h1",
          "lineEnd": 6,
          "lineStart": 6
        },
        {
          "html": "<details data-b=\"14edcb67d7af6899\" class=\"prompt-block\" data-tag=\"instructions\" open=\"\"><summary>instructions</summary>\n<p>Read <a class=\"at-ref\" href=\"/docs/guide.md\">@docs/guide.md</a> first. Greet <span class=\"tvar\">{{user}}</span> by name.</p>\n</details>",
          "id": "14edcb67d7af6899",
          "kind": "details",
          "lineEnd": 9,
          "lineStart": 9
        },
        {
          "html": "<details data-b=\"1f1a29026f2c492c\" class=\"prompt-block\" data-tag=\"example\" open=\"\"><summary>example</summary>\n<p>Input: a question about the <strong>guide</strong>.\nOutput: a short answer with a link.</p>\n</details>",
          "id": "1f1a29026f2c492c",
          "kind": "details",
          "lineEnd": 14,
          "lineStart": 13
        }
      ],
