  "docs/guide.md": {
    "body": {
      "blocks": [
        {
          "html": "<h1 data-b=\"65f4606ba1c95c40\" id=\"guide\">Guide</h1>",
          "id": "65f4606ba1c95c40",
          "kind": "h1",
          "lineEnd": 1,
          "lineStart": 1
        },
        {
          "html": "<p data-b=\"58efff504d681764\">Back to the <a href=\"../README.md\">readme</a>. More ideas in <a href=\"../notes/ideas.md#second-idea\">ideas</a>.</p>",
          "id": "58efff504d681764",
          "kind": "p",
          "lineEnd": 3,
          "lineStart": 3
        },
        {
          "html": "<h2 data-b=\"02dbe23f5510d144\" id=\"getting-started\">Getting started</h2>",
          "id": "02dbe23f5510d144",
          "kind": "h2",
          "lineEnd": 5,
          "lineStart": 5
        },
        {
          "html": "<p data-b=\"337da5e5e7be0c91\">Open a folder, pick a document in the tree, read it. Links between documents work like a wiki: use Alt+Left to go back.</p>",
          "id": "337da5e5e7be0c91",
          "kind": "p",
          "lineEnd": 7,
          "lineStart": 7
        },
        {
          "html": "<p data-b=\"8fdc87e29eccc892\"><img src=\"pm-asset:docs/img/logo.png\" alt=\"PerMark logo\"></p>",
          "id": "8fdc87e29eccc892",
          "kind": "p",
          "lineEnd": 9,
          "lineStart": 9
        },
        {
          "html": "<h2 data-b=\"e0ebc72e9d23a1a5\" id=\"shortcuts\">Shortcuts</h2>",
          "id": "e0ebc72e9d23a1a5",
          "kind": "h2",
          "lineEnd": 11,
          "lineStart": 11
        },
        {
          "html": "<table data-b=\"555cd2721da8a357\">\n<thead>\n<tr>\n<th>Keys</th>\n<th>Action</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Ctrl+F</td>\n<td>Find in page</td>\n</tr>\n<tr>\n<td>Alt+Left</td>\n<td>Back</td>\n</tr>\n<tr>\n<td>Ctrl+= / Ctrl+-</td>\n<td>Zoom</td>\n</tr>\n</tbody>\n</table>",
          "id": "555cd2721da8a357",
          "kind": "table",
          "lineEnd": 17,
          "lineStart": 13
        }
      ],
