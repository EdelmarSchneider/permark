<?xml version="1.0" encoding="utf-8"?>
<!--
  The manifest of the Microsoft Store package. scripts/build-msix.ps1 fills in the two tokens, @VERSION@ (the package
  version: the app's version and a fourth part, always 0, which the Store reserves) and @DESCRIPTION@ (the short
  description in tauri.conf.json), and packs the result with MakeAppx. The package is not signed here; the Store signs it.

  The identity (Name, Publisher, PublisherDisplayName) is what Partner Center reserved for the app and must match it
  exactly. docs/msstore.md says what each part of this file does.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="EdelmarSchneider.TrailMark"
    Publisher="CN=C8BB0009-0553-4E03-8EDF-1FC57AB0CCF7"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>TrailMark</DisplayName>
    <PublisherDisplayName>Edelmar Schneider</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 10.0.17763.0 (Windows 10, version 1809) is the first version with app execution aliases for desktop apps. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- The languages the app's interface is in. The first is the default. -->
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="pt-BR" />
    <Resource Language="es" />
    <Resource Language="de" />
  </Resources>

  <Applications>
    <Application Id="TrailMark" Executable="trailmark.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="TrailMark"
        Description="@DESCRIPTION@"
        BackgroundColor="#1F2024"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!--
          The app execution alias: puts `trailmark` on the PATH (as %LOCALAPPDATA%\Microsoft\WindowsApps\trailmark.exe).
          An AI agent starts `trailmark mcp` through it, and a hook runs `trailmark context`. The program's own path is
          inside the package folder, changes with every version and is not meant to be run directly, so the setup lines
          the Store build shows name this alias (src-tauri/src/distribution.rs keeps the two in step, with a test).
        -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="trailmark.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="trailmark.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>

        <!--
          Markdown files open with TrailMark ("Open with", and the default app once the person picks it in Windows
          Settings). The file's path is the first argument, as with the Windows installer's entries, and the app opens
          it the way it opens `trailmark <path>`.

          Not here: the "Open with TrailMark" entry of the right-click menu on folders and on the background of a
          folder. A package cannot declare that; it needs a shell extension (a COM component), which this package does not
          have yet. Files can be opened from the menu of a Markdown file, folders from within TrailMark.
        -->
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="trailmarkmarkdown" Parameters="&quot;%1&quot;">
            <uap:DisplayName>Markdown document</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.md</uap:FileType>
              <uap:FileType>.markdown</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <!-- A desktop app that reads any folder the person opens runs with the person's own rights, not in an app container. -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
