<?xml version="1.0" encoding="utf-8"?>
<!--
  The manifest of the Microsoft Store package. scripts/build-msix.ps1 fills in the two tokens, @VERSION@ (the package
  version: the app's version and a fourth part, always 0, which the Store reserves) and @DESCRIPTION@ (the short
  description in tauri.conf.json), puts permark.exe and permark_shell.dll (src-tauri/shell-ext) in the package folder
  and packs the result with MakeAppx. The package is not signed here; the Store signs it.

  The identity (Name, Publisher, PublisherDisplayName) is what Partner Center reserved for the app and must match it
  exactly. docs/msstore.md says what each part of this file does.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop desktop4 desktop5 com rescap">

  <Identity
    Name="EdelmarSchneider.TrailMark"
    Publisher="CN=C8BB0009-0553-4E03-8EDF-1FC57AB0CCF7"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>PerMark</DisplayName>
    <PublisherDisplayName>Edelmar Schneider</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 10.0.17763.0 (Windows 10, version 1809) is the first version with app execution aliases for desktop apps. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- The languages the app's interface is in. The first is the default. -->
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="pt-BR" />
    <Resource Language="es" />
    <Resource Language="de" />
    <Resource Language="zh-CN" />
    <Resource Language="it" />
  </Resources>

  <Applications>
    <Application Id="PerMark" Executable="permark.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="PerMark"
        Description="@DESCRIPTION@"
        BackgroundColor="#1F2024"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!--
          The app execution alias: puts `permark` on the PATH (as %LOCALAPPDATA%\Microsoft\WindowsApps\permark.exe).
          An AI agent starts `permark mcp` through it, and a hook runs `permark context`. The program's own path is
          inside the package folder, changes with every version and is not meant to be run directly, so the setup lines
          the Store build shows name this alias (src-tauri/src/distribution.rs keeps the two in step, with a test).
        -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="permark.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="permark.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>

        <!--
          Markdown files open with PerMark ("Open with", and the default app once the person picks it in Windows
          Settings). The file's path is the first argument, as with the Windows installer's entries, and the app opens
          it the way it opens `permark <path>`.
        -->
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="permarkmarkdown" Parameters="&quot;%1&quot;">
            <uap:DisplayName>Markdown document</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.md</uap:FileType>
              <uap:FileType>.markdown</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap3:Extension>

        <!--
          "Open with PerMark" in the right-click menu of a folder and of the background of a folder. The registry cannot do
          it for a package, so it is a COM class that implements IExplorerCommand: src-tauri/shell-ext, the DLL
          permark_shell.dll at the root of the package, next to permark.exe, which it finds from its own path. Two
          extensions: the first declares the class, the second says where it is on the menu.

          The class is declared a surrogate server, so Windows loads the DLL into its own helper process (dllhost.exe)
          and not into File Explorer: a fault in the DLL cannot take Explorer down. ThreadingModel STA is what Explorer's
          calls need (it calls the command on one thread).

          The class id below is PerMark's, generated once; it must not change, and the test in src-tauri/shell-ext
          (src/lib.rs) checks that it is the one the DLL answers to. docs/msstore.md has the rest.
        -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="PerMark shell extension">
              <com:Class Id="D5FFB935-7A42-4E3D-90E1-0180A7999B94" Path="permark_shell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>

        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="OpenWithPerMark" Clsid="D5FFB935-7A42-4E3D-90E1-0180A7999B94" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="OpenWithPerMarkHere" Clsid="D5FFB935-7A42-4E3D-90E1-0180A7999B94" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>

  <!-- A desktop app that reads any folder the person opens runs with the person's own rights, not in an app container. -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
