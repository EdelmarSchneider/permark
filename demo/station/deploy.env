# Tidewell ingest service, demo deployment. Every value here is a placeholder.
# This file is listed in .aiignore: agents connected through PerMark never see it.

TIDEWELL_API_BASE=https://api.tidewell.example/v2
TIDEWELL_KEY=demo-not-a-secret
TIDEWELL_ENV=demo

# Where the ingest service listens and what it reads
INGEST_PORT=8080
QC_RULES=station/qc-rules.yaml
GATEWAYS=north-light,avery-pier,saddle-hill

# Logging
LOG_LEVEL=info
LOG_DIR=station
